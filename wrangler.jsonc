{
  "name": "bup-ice-portal",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bup-ice-db",
      "database_id": "812cf001-e398-4dfe-8b84-8c75cddf02df"
    }
  ]
}
